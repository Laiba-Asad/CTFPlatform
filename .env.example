# =============================================================================
# Cydemic CTF // ARENA - environment configuration
# Copy to `.env` and adjust. `.env` is git-ignored: never commit it.
# Every variable is optional in development (safe local defaults are used).
# In production (NODE_ENV=production) the API refuses to start without
# SESSION_SECRET and FLAG_PEPPER.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Network / LAN -----------------------------------------------------------
# Interface the API and web dev server bind to. 0.0.0.0 = reachable from the LAN.
HOST=0.0.0.0
# API port (the Vite dev server proxies /api and /healthz to it)
API_PORT=4000
# Vite dev server port
WEB_PORT=5173
# Public address players use to reach the platform, e.g. http://192.168.1.50 or
# http://ctf.local. Leave empty in local dev. Used for cookie-secure and CORS.
PUBLIC_URL=
# Browser origins allowed to call the API with cookies (comma-separated).
# PUBLIC_URL is always allowed automatically. Dev: the Vite origin.
ALLOWED_ORIGINS=http://localhost:5173
# Optional CIDR allowlist for client IPs (comma-separated). Empty = allow all.
# Example for a venue LAN: 192.168.1.0/24
ALLOWED_SUBNETS=
# Reverse-proxy hops to trust for the real client IP (0 = none, 1 = behind one proxy).
TRUST_PROXY=0

# --- Secrets (REQUIRED in production) ----------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Signs CSRF tokens and session material. Min 32 chars.
SESSION_SECRET=
# Server-side pepper for flag HMACs. Min 32 chars.
# WARNING: changing it invalidates every stored flag hash (re-run flag:hash and re-seed).
FLAG_PEPPER=

# --- Sessions / cookies ------------------------------------------------------
# Session lifetime in hours
SESSION_TTL_HOURS=24
# Secure cookies: auto (secure only when PUBLIC_URL is https) | true | false.
# A plain-HTTP LAN deploy must stay non-secure or browsers drop the cookie.
COOKIE_SECURE=auto

# --- Database ----------------------------------------------------------------
# SQLite for local dev:   file:./dev.db   (relative paths resolve from apps/api)
# PostgreSQL on server:   postgresql://user:password@host:5432/cydemic_ctf?schema=public
# Switching provider: change this, then run `npm run db:generate -w @cydemic/api`.
DATABASE_URL=file:./dev.db

# --- Login (open join: players create themselves on first login) --------------
# A name is unique across teams (case/space/accent-insensitive). First use of a
# name creates the account on the chosen team; later uses sign back into it.
# Max players per team (0 = unlimited).
MAX_PLAYERS_PER_TEAM=0
# New-account creation rate per client IP (many players may share one LAN IP).
NEW_PLAYER_IP_LIMIT=true
NEW_PLAYERS_PER_IP=20
NEW_PLAYERS_PER_IP_WINDOW_MIN=10
# Cooldown after repeated rejected attempts. Applies to login AND flag
# submission. Default 30, HARD MAXIMUM 30 seconds.
COOLDOWN_SECONDS=30
# Rejected attempts for one name (from one IP) before the cooldown kicks in.
LOGIN_MAX_FAILURES=5
# Rejected attempts from one IP across all names before the cooldown kicks in.
LOGIN_MAX_FAILURES_PER_IP=30

# --- Scoring -----------------------------------------------------------------
# Team score: sum = sum of members' scores | unique = each flag counts once per team
TEAM_SCORING=sum
# Extra points for the first solver of a challenge (0 = off)
FIRST_BLOOD_BONUS=0
# Show hints to players
HINTS_ENABLED=true
# Deduct each hint's cost from the player's score when unlocked
HINT_COSTS_ENABLED=false
# Dynamic (decay) scoring: points drop as more players solve a challenge
DECAY_SCORING=false
DECAY_MIN_PERCENT=30
DECAY_SOLVES_TO_MIN=20

# --- Flag submission anti-abuse ----------------------------------------------
# Max submissions per user per challenge per minute
SUBMIT_RATE_LIMIT_PER_MIN=5
# Consecutive wrong answers on one challenge before the cooldown (COOLDOWN_SECONDS) kicks in
SUBMIT_LOCKOUT_FAILURES=10

# --- Challenge services (Python supervisor) ----------------------------------
# Start/stop the Python challenge processes from the platform.
CHALLENGES_ENABLED=true
# Dev convenience: release (unlock) every challenge at seed time.
AUTO_UNLOCK_ALL=false
# Per-service in-flight request cap (protects the host from one noisy scanner).
CHALLENGE_MAX_CONCURRENCY=8
# Path to the challenge-services venv Python. Empty = auto-detect.
CHALLENGE_PYTHON=

# --- Event window + mode -----------------------------------------------------
# The event state is a single source of truth (an Event row in the database).
# These seed it; the admin dashboard edits it later. Dates are ISO 8601 with
# offset, e.g. 2026-10-22T10:00:00+05:00. Leave dates empty to use seed/event.json
# (or, in live mode, a rolling dev window).
#
# PRODUCTION: set the real window here before the event. The example below is a
# 4-hour window (10:00-14:00 Asia/Karachi, +05:00) on 22 Oct 2026 - replace it
# with the organizer-confirmed date and time.
EVENT_START=2026-10-22T10:00:00+05:00
EVENT_END=2026-10-22T14:00:00+05:00
# scheduled (follow the dates) | live (force live) | paused | ended.
# Default: live in development (so you can always test), scheduled in production.
# EVENT_MODE=live is REFUSED in production - use scheduled with real dates.
EVENT_MODE=scheduled

# Timing model. `event` (default) = ONE shared clock the organizer starts from the
# admin Event page: every player sees the same countdown from a single start.
# `scheduled` = follow EVENT_START/END dates (legacy).
TIMER_MODE=event
# Length of the shared event once started, in minutes.
EVENT_DURATION_MINUTES=60
# Optionally close new sign-ups this many minutes after the event starts (0 = never).
CLOSE_SIGNUPS_AFTER_MINUTES=0

# --- Development admin seed (dev only; never used in production) --------------
# `admin:seed-dev` and the first `npm run dev` create this organizer account so
# you can sign in to /admin without the interactive prompt. Keep these out of any
# shared/committed file. CHANGE THESE before any real event (or use admin:create).
DEV_ADMIN_USERNAME="Laiba Asad"
DEV_ADMIN_PASSWORD="CTF@cydemic"

# --- Feature flags (hide unfinished sections instead of showing empty pages) --
FEATURE_INTEL=false
FEATURE_ACHIEVEMENTS=false

# --- Single-port serving (LAN) -----------------------------------------------
# `npm run start` sets these to serve the built web app from the API on one port.
SERVE_WEB=false
# Port for `npm run start` (serves web + API together).
SERVE_PORT=8080

# --- Frontend (exposed to the browser: never put secrets in VITE_ vars) -----
# How often the dashboard refreshes progress and leaderboards, in milliseconds (12-15s).
VITE_POLL_INTERVAL_MS=12000

# --- Docker (optional, server only) ------------------------------------------
# Address the proxy serves. http://localhost for local testing; a bare domain
# gets automatic HTTPS (not usable on a LAN without internet - see README).
SITE_ADDRESS=http://localhost
# Public origin browsers use to reach the site inside Docker (CORS allowlist).
PUBLIC_ORIGIN=http://localhost
# Database for the api container. Default keeps SQLite on a Docker volume.
DOCKER_DATABASE_URL=file:/data/ctf.db
# Which Prisma client the api image is built for: sqlite | postgresql.
DOCKER_DB_PROVIDER=sqlite
