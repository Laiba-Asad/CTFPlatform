// Cydemic CTF data model.
//
// This file is the single source of truth. The provider below is for local
// development (SQLite). `npm run db:pg-sync` derives prisma/postgresql/schema.prisma
// and its migrations from this file for PostgreSQL deployments. The database
// URL comes from DATABASE_URL via prisma.config.ts.
//
// Enum-like fields are strings (SQLite has no enums); allowed values are
// validated in the API with Zod and listed in comments.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

model Team {
  /// Stable slug, also the avatar file name: public/avatars/<id>.png
  id        String   @id
  name      String   @unique
  avatar    String
  tagline   String   @default("")
  /// Optional per-team player cap (null = use the global default / unlimited).
  playerCap Int?
  /// When true, no new players may join this team (existing members still log in).
  joinLocked Boolean @default(false)
  createdAt DateTime @default(now())

  users User[]
}

model User {
  id          String    @id @default(cuid())
  /// The name exactly as the player first entered it.
  name        String
  /// Normalized name (case/space/accent-insensitive). Unique across all players.
  nameKey     String    @unique
  teamId      String
  /// player | admin (legacy; organizer accounts live in AdminAccount)
  role        String    @default("player")
  /// active | banned
  status      String    @default("active")
  bannedReason String?
  createdAt   DateTime  @default(now())
  /// Client IP the player was first created from (admin live monitoring).
  createdIp   String?
  lastLoginAt DateTime?
  /// Updated on each authenticated request, for the "active now" admin view.
  lastSeenAt  DateTime?

  team             Team               @relation(fields: [teamId], references: [id])
  sessions         Session[]
  submissions      Submission[]
  solves           Solve[]
  scoreAdjustments ScoreAdjustment[]
  hintUnlocks      HintUnlock[]
  userAchievements UserAchievement[]

  @@index([teamId])
}

model Session {
  /// SHA-256 of the random session token. The raw token only exists in the cookie.
  id         String   @id
  userId     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Event {
  /// Singleton row: "main"
  id        String   @id @default("main")
  name      String
  startsAt  DateTime
  endsAt    DateTime
  /// scheduled (follow dates) | live | paused | ended. Legacy field for TIMER_MODE=scheduled.
  mode      String   @default("scheduled")
  /// Shared-clock state (TIMER_MODE=event): waiting | live | paused | ended.
  status    String   @default("waiting")
  /// When the shared event was started (null until the organizer starts it).
  startedAt DateTime?
  /// Remaining milliseconds frozen at the moment of pausing (null unless paused).
  pausedRemainingMs Int?
  /// Length of the shared event once started, in minutes.
  durationMinutes Int   @default(60)
  updatedAt DateTime @updatedAt
}

model Challenge {
  id            String   @id @default(cuid())
  number        Int      @unique
  title         String
  description   String
  category      String
  /// 1-5
  difficulty    Int
  points        Int
  /// HMAC-SHA256(FLAG_PEPPER, salt + flag). Plain-text flags are never stored.
  flagHash      String
  flagSalt      String
  /// Web challenges: the port their service listens on. Null for net challenges.
  port          Int?
  /// Admin release control. Locked = card visible, target unreachable, service stopped.
  released      Boolean  @default(false)
  /// Optional auto-release time: the challenge releases itself at/after this.
  releaseAt     DateTime?
  isLocked      Boolean  @default(false)
  /// Unlocks once the player has solved this challenge
  unlockAfterId String?
  visible       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  unlockAfter Challenge?   @relation("Unlock", fields: [unlockAfterId], references: [id], onDelete: SetNull)
  unlocks     Challenge[]  @relation("Unlock")
  hints       Hint[]
  attachments Attachment[]
  submissions Submission[]
  solves      Solve[]
}

model Hint {
  id          String @id @default(cuid())
  challengeId String
  order       Int
  content     String
  cost        Int    @default(0)

  challenge Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  unlocks   HintUnlock[]

  @@unique([challengeId, order])
}

model HintUnlock {
  userId    String
  hintId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  hint Hint @relation(fields: [hintId], references: [id], onDelete: Cascade)

  @@id([userId, hintId])
}

model Attachment {
  id          String @id @default(cuid())
  challengeId String
  /// file | link
  kind        String
  name        String
  /// Path under storage/attachments (file) or URL (link). Never served statically.
  location    String

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([challengeId])
}

/// Every flag attempt. For WRONG attempts only, the submitted text is kept for
/// admin review (shown on the Submissions page). Correct attempts never store
/// text, so a real flag is never persisted in plaintext.
model Submission {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  correct     Boolean
  /// The wrong guess (null for correct submissions). Admin-only.
  text        String?
  ip          String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId, challengeId])
  @@index([createdAt])
}

model Solve {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  points      Int
  firstBlood  Boolean  @default(false)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([challengeId])
}

model Achievement {
  /// Slug, e.g. first-flag
  id          String @id
  title       String
  description String
  icon        String

  users UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  awardedAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  pinned    Boolean   @default(false)
  /// When false the banner is hidden without deleting the record.
  active    Boolean   @default(true)
  /// Optional auto-hide time.
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Organizer accounts. Separate from players; never used for the player login.
model AdminAccount {
  id           String    @id @default(cuid())
  username     String    @unique
  usernameKey  String    @unique
  passwordHash String
  /// admin (everything) | viewer (read-only)
  role         String    @default("admin")
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  adminSessions AdminSession[]
}

model AdminSession {
  /// SHA-256 of the random session token. The raw token only exists in the cookie.
  id         String   @id
  adminId    String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  /// Hard cap (max session age) regardless of activity.
  absoluteExpiresAt DateTime
  lastSeenAt DateTime @default(now())
  ip         String?

  admin AdminAccount @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

/// Append-only record of every admin mutation.
model AuditLog {
  id        String   @id @default(cuid())
  admin     String
  action    String
  target    String?
  /// JSON strings of the before/after values (no flags, no passwords).
  before    String?
  after     String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

/// Manual score corrections, applied on top of solve points. Reversible.
model ScoreAdjustment {
  id         String    @id @default(cuid())
  userId     String
  /// Signed points (may be negative).
  points     Int
  reason     String
  admin      String
  createdAt  DateTime  @default(now())
  reversedAt DateTime?
  reversedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Singleton runtime settings the admin can change live. Null = use the env default.
model Settings {
  id                     String    @id @default("main")
  signupLocked           Boolean   @default(false)
  maintenance            Boolean   @default(false)
  leaderboardFrozen      Boolean   @default(false)
  /// When set, the leaderboard is frozen as of this time.
  freezeAt               DateTime?
  /// Optional auto-freeze this many minutes before the event ends.
  freezeMinutesBeforeEnd Int?
  /// Nullable overrides for env-driven limits (null = use env).
  cooldownSeconds        Int?
  newPlayersPerIp        Int?
  maxPlayersPerTeam      Int?
  timezone               String?
  updatedAt              DateTime  @updatedAt
}
