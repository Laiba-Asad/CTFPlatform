{
  "name": "@cydemic/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node scripts/db-prepare.mjs && node --watch --watch-preserve-output --import tsx src/server.ts",
    "build": "prisma generate && tsup",
    "start": "prisma migrate deploy && node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:pg-sync": "node scripts/db-pg-sync.mjs",
    "db:studio": "prisma studio",
    "seed": "tsx src/scripts/seed.ts",
    "reset": "tsx src/scripts/reset.ts",
    "dev:clean-players": "tsx src/scripts/clean-players.ts",
    "admin:create": "tsx src/scripts/admin-create.ts",
    "admin:reset-password": "tsx src/scripts/admin-reset-password.ts",
    "admin:seed-dev": "tsx src/scripts/admin-seed-dev.ts",
    "event:reset": "tsx src/scripts/event-reset.ts",
    "flag:hash": "tsx src/scripts/flag-hash.ts",
    "challenges:retire": "tsx src/scripts/retire-challenges.ts",
    "join-link": "tsx src/scripts/join-link.ts",
    "prod:rehash": "tsx src/scripts/prod-rehash.ts",
    "preflight": "tsx src/scripts/preflight.ts",
    "backup": "tsx src/scripts/backup.ts",
    "restore": "tsx src/scripts/restore.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cydemic/shared": "^0.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
