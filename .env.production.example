# Cydemic CTF - PRODUCTION environment (placeholders only; never commit a real .env).
# On the VM, run `npm run prod:init` to generate the real .env with strong random
# secrets and the detected LAN address. This file documents every value it sets.

NODE_ENV=production

# Bind to every interface so LAN players can reach the VM.
HOST=0.0.0.0
# Player-facing port. 8080 avoids the common Windows port-80 conflict; use 80 for
# a no-port URL only if it is free (the start script tells you if it is not).
WEB_PORT=8080

# Serve the built web app from the API on one port (single URL for players).
SERVE_WEB=true

# The address players type. Set from the VM's LAN IP, e.g. http://192.168.1.50:8080
PUBLIC_URL=http://CHANGE-ME:8080
# Browser origins allowed to call the API with cookies. Normally just PUBLIC_URL.
ALLOWED_ORIGINS=http://CHANGE-ME:8080

# Plain-HTTP LAN: cookies must NOT be Secure (browsers drop Secure cookies over http).
COOKIE_SECURE=false
# No reverse proxy in front of the VM.
TRUST_PROXY=false

# Strong random secrets (prod:init generates these). At least 32 characters each.
SESSION_SECRET=GENERATED-32-PLUS-RANDOM-CHARS
FLAG_PEPPER=GENERATED-32-PLUS-RANDOM-CHARS

# SQLite on the VM.
DATABASE_URL=file:./dev.db

# One shared clock the organizer starts; 60-minute event.
TIMER_MODE=event
EVENT_DURATION_MINUTES=60
# Scheduled mode so nothing opens until the organizer presses Start. (EVENT_MODE=live is refused.)
EVENT_MODE=scheduled

# Challenges start LOCKED in production; release them on the day. (AUTO_UNLOCK_ALL is refused.)

# Only these exact IPs may reach /admin and the admin API. Everyone else gets 404.
# Localhost (the VM) is always allowed; add your organizer laptop's LAN IP here.
ADMIN_ALLOWED_IPS=127.0.0.1,::1

# Where automatic backups are written (can be a USB drive, e.g. E:\ctf-backups).
BACKUP_DIR=backups
