# Example shape of .flags.env (the real file is git-ignored).
# Generate the real one with:  python build_flags_env.py <path-to-old-app.py>
# The flags and web5/web9 secrets are the challenge values imported from the old
# code; VISITOR_KEY is a fresh random signing key for per-visitor cookies.

FLAG_web1=<flag-for-web1>
FLAG_web2=<flag-for-web2>
FLAG_web3=<flag-for-web3>
FLAG_web4=<flag-for-web4>
FLAG_web5=<flag-for-web5>
FLAG_web6=<flag-for-web6>
FLAG_web7=<flag-for-web7>
FLAG_web8=<flag-for-web8>
FLAG_web9=<flag-for-web9>
FLAG_web10=<flag-for-web10>
FLAG_web11=<flag-for-web11>
FLAG_web12=<flag-for-web12>
FLAG_web13=<flag-for-web13>
FLAG_net1=<flag-for-net1>
FLAG_net2=<flag-for-net2>

WEB5_JWT_SECRET=<jwt-signing-secret-for-web5>
WEB9_OTP=<otp-code-for-web9>
WEB9_PHONE=<registered-phone-for-web9>
VISITOR_KEY=<random, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))">
