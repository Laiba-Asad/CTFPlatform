# Example shape of .flags.env (the real file is git-ignored).
# Create the real one with:  python build_flags_env.py <path-to-old-app.py>
# (imports web1/web2 from the old code and generates fresh flags for the
# browser-only challenges), or add missing entries to an existing file with:
#                            python build_flags_env.py --update
# VISITOR_KEY is a fresh random signing key for per-visitor cookies.

FLAG_web1=<flag-for-web1>
FLAG_web2=<flag-for-web2>
FLAG_web14=<flag-for-web14>
FLAG_web15=<flag-for-web15>
FLAG_web16=<flag-for-web16>
FLAG_web17=<flag-for-web17>
FLAG_web18=<flag-for-web18>
FLAG_web19=<flag-for-web19>
FLAG_web20=<flag-for-web20>
FLAG_web21=<flag-for-web21>
FLAG_web22=<flag-for-web22>
FLAG_web23=<flag-for-web23>
FLAG_web24=<flag-for-web24>
FLAG_web25=<flag-for-web25>
FLAG_net5=<flag-for-net5>

# web23 "Gatekeeper": the staff password its in-page script joins from pieces.
WEB23_PASSWORD=<staff-password>
VISITOR_KEY=<random, e.g. python -c "import secrets;print(secrets.token_urlsafe(32))">
