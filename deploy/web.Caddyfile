# Static file server for the built frontend (internal; the proxy sits in front).
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Fingerprinted assets can be cached forever; index.html never.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"

	# Single-page app: unknown paths fall back to index.html
	try_files {path} /index.html
	file_server
}
